# Copy to .env and fill in what you have.
# Claude plans the chains. Either uncomment and set this, or run `ant auth login` and leave it commented
# (an empty value would hide your login profile):
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Optional: Gemini instead of Claude (--planner gemini)
# GEMINI_API_KEY=

# Optional image search APIs (more reliable than scraping Bing):
# BRAVE_API_KEY=
# SERPAPI_API_KEY=
