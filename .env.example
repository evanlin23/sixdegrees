# Copy to .env and fill in what you have. Nothing here is required: by default the chains are planned
# by Claude Code on your Claude login (install Claude Code and run `claude` once).

# Only for --planner claude (the Claude API). Leave commented if you use `ant auth login` instead:
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Optional: Gemini instead of Claude (--planner gemini)
# GEMINI_API_KEY=

# Optional image search APIs (more reliable than scraping Bing):
# BRAVE_API_KEY=
# SERPAPI_API_KEY=
